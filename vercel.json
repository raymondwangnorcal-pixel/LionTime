{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/qr/:poster",
      "destination": "/api/qr?poster=:poster"
    }
  ],
  "functions": {
    "api/dining-hours.js": {
      "maxDuration": 10
    },
    "api/barnard-dining-hours.js": {
      "maxDuration": 10
    },
    "api/library-hours.js": {
      "maxDuration": 10
    },
    "api/recreation-hours.js": {
      "maxDuration": 10
    },
    "api/student-services-hours.js": {
      "maxDuration": 10
    },
    "api/dining-vote.js": {
      "maxDuration": 10
    },
    "api/qr.js": {
      "maxDuration": 10
    },
    "api/qr-stats.js": {
      "maxDuration": 10
    }
  }
}
